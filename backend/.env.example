# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/maven_bootstrap
DB_USERNAME=maven_bootstrap
DB_PASSWORD=maven_bootstrap
DB_POOL_SIZE=20
DB_POOL_MIN_IDLE=5
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=2000ms
REDIS_POOL_MAX_ACTIVE=8
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=0
REDIS_POOL_MAX_WAIT=-1ms

# Cache Configuration
CACHE_TTL=3600000

# Server Configuration
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/v1
SSL_ENABLED=false
SSL_KEYSTORE=
SSL_KEYSTORE_PASSWORD=
SSL_KEYSTORE_TYPE=PKCS12

# Security Configuration
SECURITY_REQUIRE_SSL=false

# JWT Configuration
JWT_SECRET=your-very-long-secret-key-here-at-least-256-bits-change-this-in-production
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER=maven-wrapper-bootstrap-api

# Maven Configuration
MAVEN_DEFAULT_DOWNLOAD_URL=https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven
MAVEN_WRAPPER_VERSION=3.9.5
MAVEN_DOWNLOAD_TIMEOUT=300000
MAVEN_MAX_RETRY_ATTEMPTS=3
MAVEN_RETRY_DELAY=1000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Download Configuration
DOWNLOAD_BASE_PATH=/tmp/maven-downloads
DOWNLOAD_CLEANUP_INTERVAL=3600000
DOWNLOAD_MAX_FILE_AGE=86400000

# File Upload Configuration
MAX_FILE_SIZE=100MB
MAX_REQUEST_SIZE=100MB

# Actuator Configuration
ACTUATOR_HEALTH_SHOW_DETAILS=when-authorized

# Logging Configuration
LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=INFO
WEB_LOG_LEVEL=INFO
SQL_LOG_LEVEL=WARN
SQL_BIND_LOG_LEVEL=WARN
LOG_FILE=logs/maven-bootstrap-api.log
LOG_MAX_SIZE=10MB
LOG_MAX_HISTORY=30

# Swagger Configuration
SWAGGER_ENABLED=true

# Spring Profiles
SPRING_PROFILES_ACTIVE=dev

# JPA Configuration
JPA_SHOW_SQL=false

# Maven Wrapper Credentials (for authenticated downloads)
MVNW_USERNAME=
MVNW_PASSWORD=

# External Service URLs
MAVEN_CENTRAL_URL=https://repo.maven.apache.org/maven2
MAVEN_WRAPPER_DISTRIBUTION_URL=https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper

# Monitoring Configuration
METRICS_ENABLED=true
TRACING_ENABLED=false
TRACING_ENDPOINT=

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000