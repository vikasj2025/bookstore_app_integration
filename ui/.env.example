# Application Environment
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME="Online Bookstore"
NEXT_PUBLIC_APP_VERSION=1.0.0

# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/v1
NEXT_PUBLIC_API_TIMEOUT=30000

# Authentication
NEXT_PUBLIC_JWT_SECRET_KEY=your-jwt-secret-key-here
NEXT_PUBLIC_REFRESH_TOKEN_EXPIRY=7d
NEXT_PUBLIC_ACCESS_TOKEN_EXPIRY=15m

# Feature Flags
NEXT_PUBLIC_ENABLE_MSW=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=false

# External Services
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Development Settings
NEXT_PUBLIC_DEBUG_MODE=true
NEXT_PUBLIC_LOG_LEVEL=debug

# Image Optimization
NEXT_PUBLIC_IMAGE_DOMAINS=localhost,api.bookstore.com,images.unsplash.com

# Cache Settings
NEXT_PUBLIC_CACHE_DURATION=300000
NEXT_PUBLIC_STALE_TIME=60000

# Pagination Defaults
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20
NEXT_PUBLIC_MAX_PAGE_SIZE=100

# Shopping Cart Settings
NEXT_PUBLIC_MAX_CART_ITEMS=50
NEXT_PUBLIC_CART_PERSISTENCE_DURATION=7d

# Security
NEXT_PUBLIC_ENABLE_CSP=true
NEXT_PUBLIC_ALLOWED_ORIGINS=http://localhost:3000,https://bookstore.com

# Performance
NEXT_PUBLIC_ENABLE_SW=false
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=false

# Internationalization
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,es,fr

# Theme
NEXT_PUBLIC_DEFAULT_THEME=light
NEXT_PUBLIC_ENABLE_DARK_MODE=true
