# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=build_environment
DB_USERNAME=build_env_user
DB_PASSWORD=build_env_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Server Configuration
SERVER_PORT=8080

# Logging Configuration
LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=WARN
SQL_LOG_LEVEL=WARN
SQL_PARAM_LOG_LEVEL=WARN
LOG_FILE=logs/build-environment.log

# JWT Configuration
JWT_SECRET=mySecretKey123456789012345678901234567890
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER_URI=http://localhost:8080

# Encryption Configuration
ENCRYPTION_SECRET_KEY=myEncryptionKey1234567890123456

# Build Tool Configuration
BUILD_TOOL_DOWNLOAD_TIMEOUT=300000
BUILD_TOOL_INSTALLATION_PATH=/opt/build-tools
MAX_CONCURRENT_DOWNLOADS=5

# Health Check Configuration
HEALTH_CHECK_INTERVAL=24
HEALTH_CHECK_TIMEOUT=30

# Repository Access Configuration
REPO_VALIDATION_TIMEOUT=30000
REPO_RETRY_ATTEMPTS=3

# Snapshot Configuration
SNAPSHOT_RETENTION_DAYS=30
MAX_SNAPSHOTS_PER_ENV=10

# Monitoring Configuration
METRICS_ENABLED=true
PROMETHEUS_ENABLED=true

# External Service URLs (if applicable)
# MAVEN_CENTRAL_URL=https://repo1.maven.org/maven2
# DOCKER_REGISTRY_URL=https://registry.docker.io
# GITHUB_API_URL=https://api.github.com

# Security Configuration
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.company.com
# RATE_LIMIT_REQUESTS_PER_MINUTE=100

# File Upload Configuration
# MAX_FILE_SIZE=10MB
# MAX_REQUEST_SIZE=10MB

# Cache Configuration
# CACHE_TTL_SECONDS=3600
# CACHE_MAX_ENTRIES=1000

# Async Configuration
# ASYNC_CORE_POOL_SIZE=5
# ASYNC_MAX_POOL_SIZE=20
# ASYNC_QUEUE_CAPACITY=100

# Development/Testing Configuration
# SPRING_PROFILES_ACTIVE=development
# DEBUG_MODE=false
# MOCK_EXTERNAL_SERVICES=false