# API Configuration
NEXT_PUBLIC_API_URL=https://api.bookstore.com/v1
NEXT_PUBLIC_APP_ENV=development

# Authentication
NEXT_PUBLIC_JWT_SECRET=your-jwt-secret-key
NEXT_PUBLIC_REFRESH_TOKEN_EXPIRY=7d
NEXT_PUBLIC_ACCESS_TOKEN_EXPIRY=15m

# Application Settings
NEXT_PUBLIC_APP_NAME="Online Bookstore"
NEXT_PUBLIC_APP_DESCRIPTION="Your favorite online bookstore"
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20
NEXT_PUBLIC_MAX_PAGE_SIZE=100

# Feature Flags
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_MSW=true

# External Services
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Development
NEXT_PUBLIC_MOCK_API=true
NEXT_PUBLIC_LOG_LEVEL=debug
