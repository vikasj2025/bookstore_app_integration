# Online Bookstore Backend Environment Configuration
# Copy this file to .env and update with your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=jdbc:postgresql://localhost:5432/bookstore
DATABASE_USERNAME=bookstore
DATABASE_PASSWORD=bookstore123
DB_POOL_SIZE=20
DB_POOL_MIN_IDLE=5

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
# Generate a secure random string for production
JWT_SECRET=mySecretKey123456789012345678901234567890
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER_URI=http://localhost:8080

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# =============================================================================
# PAGINATION CONFIGURATION
# =============================================================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMITING_ENABLED=true
RATE_LIMIT_RPM=60

# =============================================================================
# PAYMENT CONFIGURATION
# =============================================================================
# Stripe Configuration (get these from your Stripe dashboard)
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=WARN
SQL_LOG_LEVEL=WARN
SQL_BIND_LOG_LEVEL=WARN
LOG_FILE=logs/bookstore.log

# =============================================================================
# MONITORING AND METRICS
# =============================================================================
# Set to 'true' to enable detailed health checks
HEALTH_DETAILS_ENABLED=false

# =============================================================================
# EMAIL CONFIGURATION (if implementing email features)
# =============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=noreply@bookstore.com

# =============================================================================
# FILE STORAGE CONFIGURATION (if implementing file uploads)
# =============================================================================
# UPLOAD_PATH=/var/bookstore/uploads
# MAX_FILE_SIZE=10MB
# ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf

# =============================================================================
# EXTERNAL API CONFIGURATION
# =============================================================================
# GOOGLE_BOOKS_API_KEY=your_google_books_api_key
# GOODREADS_API_KEY=your_goodreads_api_key

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Password encryption strength (10-15 recommended for production)
BCRYPT_STRENGTH=12

# Session timeout in seconds (for admin sessions)
SESSION_TIMEOUT=3600

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
# These are used when running with Docker Compose
DOCKER_POSTGRES_VERSION=15-alpine
DOCKER_REDIS_VERSION=7-alpine

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Set to 'true' to enable development features
DEVELOPMENT_MODE=false

# Set to 'true' to enable SQL logging in development
SHOW_SQL=false

# Set to 'true' to enable debug logging
DEBUG_ENABLED=false

# =============================================================================
# PRODUCTION CONFIGURATION
# =============================================================================
# Set these for production deployment
# ALLOWED_HOSTS=bookstore.com,www.bookstore.com
# SSL_ENABLED=true
# SECURE_COOKIES=true

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=30
# BACKUP_STORAGE_PATH=/var/backups/bookstore

# =============================================================================
# NOTES
# =============================================================================
# 1. Never commit actual secrets to version control
# 2. Use strong, unique passwords for production
# 3. Rotate secrets regularly
# 4. Use environment-specific configuration files
# 5. Consider using a secrets management service for production