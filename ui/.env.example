# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Application Configuration
NEXT_PUBLIC_APP_NAME=Online Bookstore
NEXT_PUBLIC_APP_VERSION=1.0.0

# Environment
NODE_ENV=development

# Analytics (optional)
# NEXT_PUBLIC_GA_TRACKING_ID=GA_TRACKING_ID
# NEXT_PUBLIC_HOTJAR_ID=HOTJAR_ID

# Error Monitoring (optional)
# NEXT_PUBLIC_SENTRY_DSN=SENTRY_DSN

# Feature Flags (optional)
# NEXT_PUBLIC_ENABLE_MSW=true
# NEXT_PUBLIC_ENABLE_DEVTOOLS=true

# CDN Configuration (optional)
# NEXT_PUBLIC_CDN_URL=https://cdn.example.com

# Social Media (optional)
# NEXT_PUBLIC_FACEBOOK_APP_ID=FACEBOOK_APP_ID
# NEXT_PUBLIC_TWITTER_HANDLE=@bookstore

# Contact Information (optional)
# NEXT_PUBLIC_SUPPORT_EMAIL=support@bookstore.com
# NEXT_PUBLIC_SUPPORT_PHONE=1-800-BOOKS-NOW
