# API Configuration
NEXT_PUBLIC_API_BASE_URL=https://api.buildenvironment.company.com/v1
NEXT_PUBLIC_WS_URL=wss://api.buildenvironment.company.com/ws

# Environment
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Feature Flags
NEXT_PUBLIC_ENABLE_MSW=true
NEXT_PUBLIC_ENABLE_DEVTOOLS=true

# Analytics (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SENTRY_DSN=

# Authentication (if required)
NEXT_PUBLIC_AUTH_DOMAIN=
NEXT_PUBLIC_AUTH_CLIENT_ID=

# Monitoring
NEXT_PUBLIC_MONITORING_ENDPOINT=

# Build Configuration
ANALYZE=false
BUNDLE_ANALYZE=false

# Development
FAST_REFRESH=true
TURBOPACK=false

# Security
NEXT_PUBLIC_CSP_NONCE=

# Performance
NEXT_PUBLIC_PERFORMANCE_MONITORING=false

# Accessibility
NEXT_PUBLIC_A11Y_CHECKS=true

# Internationalization
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_LOCALES=en,es,fr

# Theme
NEXT_PUBLIC_DEFAULT_THEME=light

# Cache
NEXT_PUBLIC_CACHE_TTL=300000

# Rate Limiting
NEXT_PUBLIC_RATE_LIMIT_REQUESTS=100
NEXT_PUBLIC_RATE_LIMIT_WINDOW=60000

# WebSocket
NEXT_PUBLIC_WS_RECONNECT_ATTEMPTS=5
NEXT_PUBLIC_WS_RECONNECT_INTERVAL=3000

# Polling Intervals (in milliseconds)
NEXT_PUBLIC_HEALTH_CHECK_INTERVAL=60000
NEXT_PUBLIC_ENVIRONMENT_REFRESH_INTERVAL=30000
NEXT_PUBLIC_STATUS_UPDATE_INTERVAL=5000

# File Upload
NEXT_PUBLIC_MAX_FILE_SIZE=10485760
NEXT_PUBLIC_ALLOWED_FILE_TYPES=.json,.yaml,.yml,.properties

# Timeouts (in milliseconds)
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_HEALTH_CHECK_TIMEOUT=10000

# Debug
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_VERBOSE_LOGGING=false

# External Services
NEXT_PUBLIC_DOCUMENTATION_URL=https://docs.buildenvironment.company.com
NEXT_PUBLIC_SUPPORT_URL=https://support.buildenvironment.company.com
NEXT_PUBLIC_STATUS_PAGE_URL=https://status.buildenvironment.company.com
