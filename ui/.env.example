# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_API_TIMEOUT=30000

# Application Configuration
NEXT_PUBLIC_APP_NAME="Online Bookstore"
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENV=development

# Authentication
NEXT_PUBLIC_JWT_SECRET=your-jwt-secret-key-here
NEXT_PUBLIC_REFRESH_TOKEN_EXPIRY=604800
NEXT_PUBLIC_ACCESS_TOKEN_EXPIRY=3600

# Payment Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key_here

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=false
NEXT_PUBLIC_ENABLE_MSW=true

# Monitoring and Logging
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_LOG_LEVEL=info

# CDN and Assets
NEXT_PUBLIC_CDN_URL=
NEXT_PUBLIC_IMAGE_OPTIMIZATION=true

# Cache Configuration
NEXT_PUBLIC_CACHE_TTL=300
NEXT_PUBLIC_STALE_WHILE_REVALIDATE=60

# Rate Limiting
NEXT_PUBLIC_RATE_LIMIT_REQUESTS=100
NEXT_PUBLIC_RATE_LIMIT_WINDOW=60000

# Development Tools
NEXT_PUBLIC_SHOW_DEVTOOLS=true
NEXT_PUBLIC_MOCK_API=true

# Security
NEXT_PUBLIC_CSP_NONCE=
NEXT_PUBLIC_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
