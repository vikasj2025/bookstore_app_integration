# API Configuration
NEXT_PUBLIC_API_BASE_URL=https://api.mavenbootstrap.com/v1
NEXT_PUBLIC_WS_URL=wss://api.mavenbootstrap.com/ws

# Authentication
NEXT_PUBLIC_AUTH_DOMAIN=auth.mavenbootstrap.com
NEXT_PUBLIC_CLIENT_ID=your-client-id

# Environment
NODE_ENV=development
NEXT_PUBLIC_ENVIRONMENT=development

# Monitoring & Analytics
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# Feature Flags
NEXT_PUBLIC_ENABLE_WEBSOCKETS=true
NEXT_PUBLIC_ENABLE_REAL_TIME_MONITORING=true
NEXT_PUBLIC_ENABLE_CACHE_MANAGEMENT=true

# Development
NEXT_PUBLIC_DEBUG=false
NEXT_PUBLIC_LOG_LEVEL=info

# Security
NEXT_PUBLIC_CSP_NONCE=
NEXT_PUBLIC_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Performance
NEXT_PUBLIC_ENABLE_SERVICE_WORKER=true
NEXT_PUBLIC_CACHE_TIMEOUT=300000

# UI Configuration
NEXT_PUBLIC_THEME=light
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
NEXT_PUBLIC_TIMEZONE=UTC

# Build Configuration
NEXT_PUBLIC_BUILD_ID=
NEXT_PUBLIC_VERSION=1.0.0
